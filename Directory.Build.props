<Project>
  <!-- Shared settings for every project. Per-package PackageId/Description/PackageTags go in each .csproj. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <Authors>Joe Cleland (yozepi@gmail.com)</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/yozepi/Specs</RepositoryUrl>
    <PackageProjectUrl>https://github.com/yozepi/Specs/wiki</PackageProjectUrl>
    <PackageIcon>Specs-BDD.png</PackageIcon>

    <!-- Shared tags; each .csproj appends its own via $(PackageTags) -->
    <PackageTags>bdd;specs;specifications;testing;tdd;rspec;nspec</PackageTags>
    <PackageReleaseNotes>https://github.com/yozepi/Specs/releases</PackageReleaseNotes>
    <PackageReleaseNotes Condition="'$(GITHUB_REF_TYPE)' == 'tag'">https://github.com/yozepi/Specs/releases/tag/$(GITHUB_REF_NAME)</PackageReleaseNotes>

    <!-- Version comes from the git tag (v1.2.0 -> 1.2.0). Untagged commits get 1.2.1-alpha.0.N. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>

    <!-- Debuggable packages: SourceLink is built into the SDK; publish symbols as .snupkg -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Deterministic builds on CI only (keeps local debugging paths normal) -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)documents\images\Specs-BDD.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- A ProjectReference with PrivateAssets="all" is embedded in this package instead of becoming a dependency. -->
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludePrivateProjectReferencesInPackage</TargetsForTfmSpecificBuildOutput>
    <TargetsForTfmSpecificDebugSymbolsInPackage>$(TargetsForTfmSpecificDebugSymbolsInPackage);IncludePrivateProjectReferenceSymbolsInPackage</TargetsForTfmSpecificDebugSymbolsInPackage>
    <!-- Otherwise ResolveReferences builds the referenced projects under NoBuild (NETSDK1085). -->
    <BuildProjectReferences Condition="'$(NoBuild)' == 'true'">false</BuildProjectReferences>
  </PropertyGroup>

  <Target Name="_GetPrivateProjectReferenceAssemblies" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_PrivateProjectReferenceAssembly Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference')->WithMetadataValue('PrivateAssets', 'all')->WithMetadataValue('Extension', '.dll'))" />
    </ItemGroup>
  </Target>

  <Target Name="IncludePrivateProjectReferencesInPackage" DependsOnTargets="_GetPrivateProjectReferenceAssemblies">
    <ItemGroup>
      <BuildOutputInPackage Include="@(_PrivateProjectReferenceAssembly)" />
      <BuildOutputInPackage Include="@(_PrivateProjectReferenceAssembly->'%(RootDir)%(Directory)%(Filename).xml')" Condition="Exists('%(RootDir)%(Directory)%(Filename).xml')" />
    </ItemGroup>
  </Target>

  <Target Name="IncludePrivateProjectReferenceSymbolsInPackage" DependsOnTargets="_GetPrivateProjectReferenceAssemblies">
    <ItemGroup>
      <TfmSpecificDebugSymbolsFile Include="@(_PrivateProjectReferenceAssembly->'%(RootDir)%(Directory)%(Filename).pdb')" Condition="Exists('%(RootDir)%(Directory)%(Filename).pdb')" TargetFramework="$(TargetFramework)" />
    </ItemGroup>
  </Target>

  <!-- The SDK silently defaults Description to "Package Description" -->
  <Target Name="ValidatePackageMetadata" BeforeTargets="GenerateNuspec" Condition="'$(IsPackable)' != 'false'">
    <Error Condition="'$(Description)' == '' Or '$(Description)' == 'Package Description'"
           Text="$(MSBuildProjectName): set a package Description in the .csproj." />
    <Error Condition="'$(PackageTags)' == ''"
           Text="$(MSBuildProjectName): set PackageTags." />
  </Target>
</Project>
