<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>10</LangVersion>
    <Description>BDD authoring API for Specs: derive from Specifications and write nested Describe/Context/It specs with BeforeAll, BeforeEach, Act, AfterEach and AfterAll hooks, first-class async support, pending specs, and expected-exception specs.</Description>
    <PackageTags>$(PackageTags);describe;context;it;async</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="specs.BDD.VSTestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\specs.core\specs.core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="AssertBuilder.cs" />
  </ItemGroup>

</Project>
