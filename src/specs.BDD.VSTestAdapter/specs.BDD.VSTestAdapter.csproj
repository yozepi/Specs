<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>10</LangVersion>
    <Description>VSTest adapter for Specs: discovers and runs Specifications-based specs in Visual Studio Test Explorer and dotnet test, with source navigation, nested Test Explorer hierarchy, --filter support, and optional grouped execution.</Description>
    <PackageTags>$(PackageTags);vstest;testadapter;test-explorer;dotnet-test</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.TestPlatform.ObjectModel" />                                                                
    <PackageReference Include="System.Reflection.Metadata" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\specs.core\specs.core.csproj" />
    <ProjectReference Include="..\specs.specification\specs.BDD.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\specs.BDD.Runner\**\*.cs" LinkBase="Runner" />
  </ItemGroup>

</Project>
