<Project Sdk="Microsoft.NET.Sdk">

  <!-- A project reference doesn't import the package's build props, so wire the builder hook in directly. -->
  <Import Project="..\..\..\src\specs.BDD.TestingPlatform\build\specs.BDD.MTP.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>specs.BDD.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NFluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\specs.BDD.TestingPlatform\specs.BDD.TestingPlatform.csproj" />
    <ProjectReference Include="..\..\..\src\specs.specification\specs.BDD.csproj" />
  </ItemGroup>

  <!-- The same specs as specs.BDD.IntegrationTests, run through Microsoft.Testing.Platform. -->
  <ItemGroup>
    <Compile Include="..\..\specs.BDD.IntegrationTests\*.cs" LinkBase="Specs" />
  </ItemGroup>

</Project>
